#!/bin/sh
#
# /init - Initramfs init script for Minimal i486 Linux
#
# This script runs as PID 1 in the initramfs and:
# 1. Mounts essential filesystems (/proc, /sys, /dev)
# 2. Finds and mounts the boot media (CD-ROM)
# 3. Mounts SquashFS root with tmpfs overlay for read-write
# 4. Pivots to the overlay root and executes /sbin/init
#
# Kernel parameters:
#   root=/dev/xxx   - Override: mount this device as root instead of squashfs
#   rootfstype=xxx  - Root filesystem type (default: auto)
#   rootflags=xxx   - Root filesystem mount options
#   init=/path      - Init program on real root (default: /sbin/init)
#   debug           - Enable verbose output
#   rescue          - Force rescue shell
#   toram           - Copy squashfs to RAM (uses more memory, allows ejecting CD)
#   persist         - Use a partition labeled MONOLITH_PERSIST as the overlay
#                     upper/work dir instead of tmpfs, so changes survive a
#                     reboot. Falls back to tmpfs (with a warning) if no such
#                     partition is found. Create one with:
#                       mkfs.ext4 -L MONOLITH_PERSIST /dev/sdXN

# Enable job control (needed for proper shell behavior)
set -m

# A kernel-started PID 1 inherits a minimal/empty PATH. Set a sane one so
# external binaries in the initramfs (notably /bin/kmod's modprobe) resolve.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

# ============================================================================
# Helper functions
# ============================================================================

msg() {
    echo "[init] $*"
}

err() {
    echo "[init] ERROR: $*" >&2
}

dbg() {
    [ "$DEBUG" = "1" ] && echo "[init] DEBUG: $*"
}

# Parse kernel command line parameter
cmdline_get() {
    local param="$1"
    local default="$2"
    local value

    if [ -r /proc/cmdline ]; then
        for arg in $(cat /proc/cmdline); do
            case "$arg" in
                ${param}=*)
                    value="${arg#*=}"
                    ;;
            esac
        done
    fi

    echo "${value:-$default}"
}

# Check if parameter exists in cmdline
cmdline_has() {
    local param="$1"

    if [ -r /proc/cmdline ]; then
        grep -qw "$param" /proc/cmdline
        return $?
    fi
    return 1
}

# Wait for a device to appear
wait_for_device() {
    local device="$1"
    local timeout="${2:-10}"
    local count=0

    msg "Waiting for device $device..."

    while [ ! -e "$device" ] && [ $count -lt $timeout ]; do
        sleep 1
        count=$((count + 1))
        dbg "Waiting... ($count/$timeout)"
    done

    [ -e "$device" ]
}

# Coldplug pass: read every device's modalias and modprobe the match. Only the
# Tier-1 storage drivers were bundled into this initramfs (see
# configs/initrd-modules.txt), so modprobe silently no-ops on aliases for
# rootfs-only drivers (NIC, sound, ...) that aren't here yet — they load later
# from the squashfs. Loads exactly the storage controllers this machine has.
# Resolved once by load_storage_modules to the kmod loader (by explicit path,
# not via PATH). May be "/bin/kmod modprobe" — used unquoted so it word-splits.
MODPROBE=

coldplug_once() {
    [ -n "$MODPROBE" ] || return 0
    find /sys -name modalias -type f 2>/dev/null | while read -r _ma; do
        $MODPROBE -q "$(cat "$_ma")" 2>/dev/null || true
    done
}

# Load the Tier-1 boot-media drivers so AHCI/NVMe/USB/SAS/SATA/MMC/... devices
# enumerate BEFORE we search for rootfs.squashfs. This is COLDPLUG ONLY: kmod
# matches each present device's modalias against modules.alias and loads just
# the drivers this machine's controllers actually need — not the whole manifest.
# A machine that boots from built-in IDE (or has none of these controllers)
# loads nothing and keeps nothing resident after switch_root. The full manifest
# is a last resort (load_manifest_fallback), reached only if the media search
# cannot otherwise find the boot device. See docs/kernel-tiers.md.
load_storage_modules() {
    # Detect the bundled module tree WITHOUT the `uname` applet (busybox here may
    # lack it; modprobe self-locates the tree via the uname(2) syscall anyway).
    _have_mods=0
    for _md in /lib/modules/*/modules.dep; do
        [ -f "$_md" ] && _have_mods=1 && break
    done
    [ "$_have_mods" = 1 ] || { dbg "no modules bundled in initramfs"; return 0; }

    # Resolve the module loader (kmod, installed by build-initrd.sh) by explicit
    # path — do NOT trust PATH or `command -v`, since a kernel-started init has a
    # minimal environment. kmod dispatches on argv[0], so /bin/kmod is invoked as
    # "kmod modprobe". MODPROBE is global so the media-search retries and the
    # manifest fallback reuse it.
    MODPROBE=
    for _c in /sbin/modprobe /bin/modprobe /usr/bin/kmod /bin/kmod; do
        [ -x "$_c" ] && { MODPROBE="$_c"; break; }
    done
    case "$_c" in */kmod) MODPROBE="$_c modprobe" ;; esac
    if [ -z "$MODPROBE" ]; then
        err "no module loader (kmod) found in initramfs — cannot load boot-media drivers"
        return 0
    fi
    dbg "module loader: $MODPROBE"

    msg "Loading boot-media drivers (Tier 1, coldplug)..."
    coldplug_once
    # Settle: a disk behind a bus we just enabled (USB/SD/SATA) appears a beat
    # later — coldplug again for it, then refresh /dev nodes.
    sleep 1
    coldplug_once
    command -v mdev >/dev/null 2>&1 && mdev -s 2>/dev/null || true

    msg "Boot-media drivers loaded ($(lsmod 2>/dev/null | tail -n +2 | wc -l) module(s) resident)"
}

# Last resort: force-load EVERY module in the manifest by name, for the rare
# controller whose modalias coldplug didn't match. This trades RAM (all ~40
# storage drivers resident, kept even after switch_root) for reach, so the media
# search calls it ONLY after coldplug + retries have failed — never on a machine
# that already found its boot device. Failures are surfaced to the console.
load_manifest_fallback() {
    [ -n "$MODPROBE" ] && [ -r /etc/initrd-modules ] || return 0
    msg "Boot media not found via coldplug — force-loading the full driver manifest..."
    while read -r _mod; do
        case "$_mod" in ''|\#*) continue ;; esac
        if ! _err=$($MODPROBE "$_mod" 2>&1); then
            [ -n "$_err" ] && msg "  note: modprobe $_mod: $_err"
        fi
    done < /etc/initrd-modules
    sleep 1
    coldplug_once
    command -v mdev >/dev/null 2>&1 && mdev -s 2>/dev/null || true
}

# Drop to rescue shell
rescue_shell() {
    err "Dropping to rescue shell"
    err "Type 'exit' to continue booting (if possible)"
    echo
    _ver=$(cat /etc/monolith-release 2>/dev/null)
    echo "=========================================="
    echo "  tHE m0n0LiTH${_ver:+ $_ver} - rescue shell"
    echo "=========================================="
    echo
    echo "Available commands: $(busybox --list | tr '\n' ' ' | head -c 60)..."
    echo
    echo "Useful commands:"
    echo "  cat /proc/cmdline    - Show kernel parameters"
    echo "  cat /proc/partitions - Show available partitions"
    echo "  ls /media            - Show boot media contents"
    echo "  mount /dev/xxx /mnt  - Mount a filesystem"
    echo
    exec /bin/sh
}

# ============================================================================
# Main init sequence
# ============================================================================

msg "Starting init..."

if [ $$ -ne 1 ]; then
    err "This script must run as PID 1"
    exit 1
fi

# ============================================================================
# Mount essential filesystems
# ============================================================================

msg "Mounting essential filesystems..."

mount -t proc proc /proc || { err "Failed to mount /proc"; rescue_shell; }
mount -t sysfs sysfs /sys || { err "Failed to mount /sys"; rescue_shell; }

if ! mount -t devtmpfs devtmpfs /dev; then
    msg "devtmpfs not available, using tmpfs"
    mount -t tmpfs tmpfs /dev || { err "Failed to mount /dev"; rescue_shell; }
    mknod /dev/console c 5 1
    mknod /dev/null c 1 3
    mknod /dev/zero c 1 5
    mknod /dev/tty c 5 0
fi

mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true

# Coldplug scan: create device NODES (/dev/sda, /dev/sda1, ...) for block
# devices already present so the scans below can open them. NOTE: `mdev -s`
# does NOT populate /dev/disk/by-label/* here — that needs mdev.conf rules plus
# a blkid/findfs helper, neither of which is in this initramfs. Label lookups
# below therefore resolve via `findfs` (BusyBox, CONFIG_VOLUMEID) or a direct
# superblock read, not by-label symlinks.
if command -v mdev >/dev/null 2>&1; then
    mdev -s 2>/dev/null || true
fi

# ============================================================================
# Parse kernel command line
# ============================================================================

msg "Parsing kernel command line..."
dbg "cmdline: $(cat /proc/cmdline)"

cmdline_has debug && DEBUG=1 && msg "Debug mode enabled"
cmdline_has rescue && { msg "Rescue mode requested"; rescue_shell; }

ROOT_DEV=$(cmdline_get root "")
ROOT_TYPE=$(cmdline_get rootfstype "auto")
ROOT_FLAGS=$(cmdline_get rootflags "ro")
INIT_PROG=$(cmdline_get init "/sbin/init")
TORAM=$(cmdline_has toram && echo 1 || echo 0)
PERSIST=$(cmdline_has persist && echo 1 || echo 0)

dbg "ROOT_DEV=$ROOT_DEV ROOT_TYPE=$ROOT_TYPE INIT_PROG=$INIT_PROG TORAM=$TORAM PERSIST=$PERSIST"

# ============================================================================
# Load boot-media drivers (Tier 1) before any device search
# ============================================================================
# Both the root= path and the squashfs search need the controller drivers
# present. `nomodules` skips this (debugging / a machine that is entirely
# Tier-0 built-in and wants the fastest possible boot).
if cmdline_has nomodules; then
    msg "nomodules: skipping initramfs driver load"
else
    load_storage_modules
fi

# ============================================================================
# If root= specified, use traditional mount (no overlay)
# ============================================================================

if [ -n "$ROOT_DEV" ]; then
    msg "Using traditional root mount: $ROOT_DEV"

    wait_for_device "$ROOT_DEV" 30 || {
        err "Root device $ROOT_DEV not found"
        cat /proc/partitions
        rescue_shell
    }

    mkdir -p /newroot
    mount -t "$ROOT_TYPE" -o "$ROOT_FLAGS" "$ROOT_DEV" /newroot || {
        err "Failed to mount $ROOT_DEV"
        rescue_shell
    }

    # Skip to pivot_root section
    OVERLAY_MODE=0
else
    OVERLAY_MODE=1
fi

# ============================================================================
# SquashFS + Overlay mode (default when no root= specified)
# ============================================================================

if [ "$OVERLAY_MODE" = "1" ]; then
    msg "Setting up SquashFS with overlay..."

    # Create mount points
    mkdir -p /media /squashfs /overlay /overlay/upper /overlay/work /newroot

    # Find and mount boot media. The three passes (known CD nodes, by-label,
    # then every block device) live in scan_for_boot_media and run inside a
    # retry loop: a modular storage bus (USB/NVMe/SAS/SATA) can enumerate its
    # disk a beat after the driver loads, so if the first sweep is empty we
    # settle, re-coldplug, and sweep again. Media already present (built-in IDE
    # CD) is found on attempt 1 and never sleeps.
    msg "Searching for boot media..."
    BOOT_MEDIA=""

    scan_for_boot_media() {
        # Pass 1: known CD-ROM device nodes.
        for dev in /dev/sr0 /dev/sr1 /dev/cdrom /dev/hdc /dev/hdd; do
            [ -e "$dev" ] || continue
            dbg "Trying $dev..."
            if mount -t iso9660 -o ro "$dev" /media 2>/dev/null; then
                if [ -f /media/rootfs.squashfs ]; then
                    BOOT_MEDIA="$dev"; msg "Found boot media at $dev"; return 0
                fi
                umount /media
            fi
        done

        # Pass 2: /dev/disk/by-label if populated.
        if [ -d /dev/disk/by-label ]; then
            for label in MONOLITH LIVECD; do
                dev="/dev/disk/by-label/$label"
                [ -e "$dev" ] || continue
                dbg "Trying label $label..."
                if mount -t iso9660 -o ro "$dev" /media 2>/dev/null; then
                    if [ -f /media/rootfs.squashfs ]; then
                        BOOT_MEDIA="$dev"; msg "Found boot media at $label"; return 0
                    fi
                    umount /media
                fi
            done
        fi

        # Pass 3: every block device — USB sticks, SATA/NVMe/SAS/MMC disks, and
        # isohybrid media written to a raw disk all surface here once their
        # Tier-1 driver has loaded.
        dbg "Scanning all block devices..."
        for sysdev in /sys/block/*; do
            devname="${sysdev##*/}"
            case "$devname" in loop*|ram*) continue ;; esac
            for dev in "/dev/$devname" "/dev/${devname}"[0-9]*; do
                [ -b "$dev" ] || continue
                dbg "Trying block device $dev..."
                if mount -o ro "$dev" /media 2>/dev/null; then
                    if [ -f /media/rootfs.squashfs ]; then
                        BOOT_MEDIA="$dev"; msg "Found boot media at $dev"; return 0
                    fi
                    umount /media
                fi
            done
        done
        return 1
    }

    _media_attempt=1
    while [ -z "$BOOT_MEDIA" ] && [ "$_media_attempt" -le 4 ]; do
        if [ "$_media_attempt" -gt 1 ]; then
            dbg "boot media not found yet (attempt $_media_attempt) — settling and re-coldplugging"
            sleep 2
            coldplug_once
            command -v mdev >/dev/null 2>&1 && mdev -s 2>/dev/null || true
        fi
        scan_for_boot_media || true
        _media_attempt=$((_media_attempt + 1))
    done

    # Desperation: coldplug never surfaced the boot device. Force-load the whole
    # driver manifest and sweep once more before giving up (covers a controller
    # whose modalias didn't match). Only reached when nothing else worked.
    if [ -z "$BOOT_MEDIA" ]; then
        load_manifest_fallback
        scan_for_boot_media || true
    fi

    if [ -z "$BOOT_MEDIA" ]; then
        err "Could not find boot media with rootfs.squashfs"
        msg "Available block devices:"
        cat /proc/partitions
        rescue_shell
    fi

    # Optionally copy squashfs to RAM
    SQUASHFS_PATH="/media/rootfs.squashfs"
    if [ "$TORAM" = "1" ]; then
        msg "Copying rootfs to RAM (this may take a moment)..."
        mkdir -p /ram
        mount -t tmpfs -o size=80% tmpfs /ram
        cp /media/rootfs.squashfs /ram/rootfs.squashfs || {
            err "Failed to copy squashfs to RAM (not enough memory?)"
            umount /ram
            TORAM=0
        }
        if [ "$TORAM" = "1" ]; then
            SQUASHFS_PATH="/ram/rootfs.squashfs"
            umount /media
            msg "Boot media can now be ejected"
        fi
    fi

    # Mount the SquashFS
    msg "Mounting SquashFS root..."
    if ! mount -t squashfs -o ro "$SQUASHFS_PATH" /squashfs; then
        err "Failed to mount SquashFS"
        rescue_shell
    fi

    # Set up storage for the overlay upper/work dirs: a persistent partition
    # if 'persist' was requested and found, tmpfs otherwise (the default).
    if [ "$PERSIST" = "1" ]; then
        msg "Persistence requested — looking for MONOLITH_PERSIST partition..."
        PERSIST_DEV=""
        # Resolve the LABEL to a block device ourselves — mdev -s does not create
        # /dev/disk/by-label symlinks in this initramfs (no mdev.conf/blkid helper).
        # Primary: findfs (BusyBox applet, backed by CONFIG_VOLUMEID).
        if command -v findfs >/dev/null 2>&1; then
            PERSIST_DEV=$(findfs LABEL=MONOLITH_PERSIST 2>/dev/null || true)
        fi
        # Compatibility: honour a real by-label symlink if one happens to exist.
        if [ -z "$PERSIST_DEV" ] && [ -e /dev/disk/by-label/MONOLITH_PERSIST ]; then
            PERSIST_DEV="/dev/disk/by-label/MONOLITH_PERSIST"
        fi
        # Fallback: scan partitions and read the ext2/3/4 volume label straight
        # from the superblock (label at byte offset 0x478, 16 bytes). Covers the
        # documented ext4 persist partition even if findfs is unavailable.
        if [ -z "$PERSIST_DEV" ]; then
            for sysdev in /sys/block/*; do
                [ -n "$PERSIST_DEV" ] && break
                devname="${sysdev##*/}"
                case "$devname" in loop*|ram*|sr*) continue ;; esac
                for dev in "/dev/$devname" "/dev/${devname}"[0-9]*; do
                    [ -b "$dev" ] || continue
                    lbl=$(dd if="$dev" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\0')
                    if [ "$lbl" = "MONOLITH_PERSIST" ]; then
                        PERSIST_DEV="$dev"
                        break
                    fi
                done
            done
        fi

        if [ -n "$PERSIST_DEV" ] && wait_for_device "$PERSIST_DEV" 5; then
            msg "Found persistence partition: $PERSIST_DEV"

            # Best-effort fsck. BusyBox in the initramfs only provides
            # fsck.minix (CONFIG_FSCK_MINIX) — there is no e2fsck/dosfsck
            # here to check ext4/vfat, so this is a no-op unless a fsck
            # applet for the partition's filesystem happens to be present.
            # A journaled filesystem (ext4 is what the mkfs one-liner above
            # recommends) replays its journal on mount, which covers the
            # common "unclean shutdown" case even without an explicit fsck.
            if command -v fsck >/dev/null 2>&1; then
                msg "Checking persistence filesystem..."
                fsck -y "$PERSIST_DEV" 2>/dev/null || dbg "fsck reported issues or is unsupported for this fs; continuing"
            else
                dbg "No fsck applet in initramfs; relying on filesystem journal replay on mount"
            fi

            if mount -t auto -o rw "$PERSIST_DEV" /overlay; then
                msg "Persistence partition mounted — changes will survive reboot"
            else
                err "Failed to mount $PERSIST_DEV; falling back to tmpfs (changes will NOT persist)"
                PERSIST=0
            fi
        else
            err "'persist' requested but no MONOLITH_PERSIST partition found"
            err "Falling back to tmpfs (changes will NOT persist). Create one with:"
            err "  mkfs.ext4 -L MONOLITH_PERSIST /dev/sdXN"
            PERSIST=0
        fi
    fi

    if [ "$PERSIST" != "1" ]; then
        msg "Creating tmpfs overlay..."
        mount -t tmpfs -o size=50% tmpfs /overlay || {
            err "Failed to mount overlay tmpfs"
            rescue_shell
        }
    fi
    mkdir -p /overlay/upper /overlay/work

    # Mount overlayfs
    msg "Mounting overlay filesystem..."
    if ! mount -t overlay -o lowerdir=/squashfs,upperdir=/overlay/upper,workdir=/overlay/work overlay /newroot; then
        err "Failed to mount overlayfs"
        rescue_shell
    fi

    # Create mount points in new root for our special filesystems
    mkdir -p /newroot/media /newroot/squashfs /newroot/overlay

    # Move our mounts into the new root so they persist
    mount --move /squashfs /newroot/squashfs 2>/dev/null || mount --bind /squashfs /newroot/squashfs
    mount --move /overlay /newroot/overlay 2>/dev/null || mount --bind /overlay /newroot/overlay
    [ "$TORAM" != "1" ] && (mount --move /media /newroot/media 2>/dev/null || mount --bind /media /newroot/media)
    [ "$TORAM" = "1" ] && [ -d /ram ] && (mkdir -p /newroot/ram && mount --move /ram /newroot/ram 2>/dev/null || true)

    msg "Overlay root ready"
fi

# ============================================================================
# Verify init exists
# ============================================================================

if [ ! -x "/newroot${INIT_PROG}" ]; then
    # Try common alternatives
    for alt in /sbin/init /bin/sh; do
        if [ -x "/newroot${alt}" ]; then
            msg "Using alternate init: $alt"
            INIT_PROG="$alt"
            break
        fi
    done
fi

if [ ! -x "/newroot${INIT_PROG}" ]; then
    err "Init program not found: /newroot${INIT_PROG}"
    ls -la /newroot/
    rescue_shell
fi

# ============================================================================
# Pivot to real root
# ============================================================================

msg "Pivoting to real root..."

mkdir -p /newroot/proc /newroot/sys /newroot/dev

mount --move /proc /newroot/proc 2>/dev/null || true
mount --move /sys /newroot/sys 2>/dev/null || true
mount --move /dev /newroot/dev 2>/dev/null || true

cd /newroot
mkdir -p mnt/initramfs

if ! pivot_root . mnt/initramfs; then
    # pivot_root returns EINVAL on an overlayfs new-root (a known limitation);
    # switch_root is the correct path for overlay roots. Announce the exec here
    # too so the boot proceeds identically to the pivot_root path (and so log
    # watchers see the same "Executing ..." milestone regardless of which path
    # is taken).
    dbg "pivot_root not supported here (overlayfs); using switch_root"
    msg "Executing $INIT_PROG..."
    exec switch_root /newroot "$INIT_PROG"
fi

# Clean up initramfs (optional - keeps it for debugging)
# umount -l /mnt/initramfs 2>/dev/null || true

# ============================================================================
# Execute real init
# ============================================================================

msg "Executing $INIT_PROG..."
exec chroot . "$INIT_PROG" "$@"

err "Failed to execute $INIT_PROG"
rescue_shell
