# Gentoo world file for i486-linux-musl cross-compiled packages
#
# Standard Gentoo format: one atom per line
# These packages will be built statically for the minimal Linux system
#
# Add packages here and run: make build-packages

# Kernel (cross-compiled via monolith overlay ebuild)
sys-kernel/monolith-kernel

# BusyBox (for initramfs — cross-compiled with savedconfig)
sys-apps/busybox

# Shells
app-shells/bash
app-shells/dash

# Init system (replaces BusyBox init)
sys-apps/sysvinit

# Core GNU userland (replaces BusyBox applets)
sys-apps/coreutils
sys-apps/util-linux
sys-apps/findutils
sys-apps/grep
sys-apps/sed
sys-apps/gawk
sys-apps/diffutils
app-arch/tar
app-text/tree

# Core libraries (available for development)
sys-libs/readline
sys-libs/ncurses
sys-libs/zlib
dev-libs/libpcre2
dev-libs/openssl

# File utilities
sys-apps/file
sys-apps/less

# Text editors
app-editors/vim
app-editors/nano

# Man pages
sys-apps/man-pages
app-text/mandoc

# Development tools
sys-devel/binutils
dev-build/make
dev-debug/strace
sys-devel/patch

# Scripting languages
dev-lang/lua

# Compression utilities
app-arch/xz-utils
app-arch/bzip2
app-arch/gzip

# Networking (replaces BusyBox udhcpc/ifconfig)
sys-apps/iproute2
sys-apps/net-tools
net-misc/iputils
net-misc/dhcpcd
# ethtool — NIC driver/hardware control (speed/duplex/autoneg/offload/etc.).
# net-tools is already in world above and covers ifconfig/route/mii-tool;
# ethtool is the modern complement for NIC feature control net-tools never
# had. Pulls in net-libs/libmnl (new dep, see below) for its netlink path.
sys-apps/ethtool

# Firewall / NAT (see monolith-router; SP2)
net-firewall/nftables

# DHCP + DNS for the LAN (see monolith-router --dhcp; SP3)
net-dns/dnsmasq

# Remote access
net-misc/dropbear

# Network utilities
net-misc/curl
net-misc/wget
net-misc/whois
net-analyzer/netcat
net-analyzer/traceroute
# iperf3 — TCP/UDP bandwidth tester (+cJSON). Also the canary for the cross-gcc
# libatomic.a fix: iperf3 needs 8-byte atomics, which on -march=i486 require
# libatomic — it failed to static-link until the toolchain built libatomic.a
# (Dockerfile cross-gcc-static.conf). If this builds, the fix works.
net-misc/iperf:3

# Dial-up / WAN
# ppp — pppd (PPP daemon) + chat, for serial and PPPoE WAN links. Kernel PPP
# is already enabled (CONFIG_PPP=y). Loadable plugins are disabled entirely
# (--disable-plugins via env/ppp-no-plugins.conf) since this all-static rootfs
# has no dynamic loader; base pppd/chat are plain static programs. ppp-scripts
# (ip-up/ip-down) is PDEPEND-pulled automatically, not listed here.
net-dialup/ppp

# Network clients
www-client/lynx
# mutt — terminal email client. IMAP+SMTP over TLS; SMTP send via USE=gsasl
# (net-misc/gsasl) to avoid the cyrus-sasl -> tmpfiles -> Python chain. ncurses
# UI links with -ltinfo (env/mutt-tinfo.conf) for this repo's tinfo-split ncurses.
mail-client/mutt

# Terminal multiplexer
app-misc/tmux

# User/password management
sys-apps/shadow

# System utilities
sys-process/procps
sys-process/htop
sys-process/lsof
app-admin/sysklogd

# Filesystem tools
sys-fs/e2fsprogs
sys-fs/dosfstools
sys-fs/squashfs-tools

# Additional shells
app-shells/zsh
app-shells/bash-completion

# File managers and search
net-misc/rsync
sys-apps/the_silver_searcher

# Additional compression
app-arch/zip
app-arch/unzip

# Network analysis
net-misc/socat
net-analyzer/iftop
net-analyzer/tcpdump
# mtr — combined ping+traceroute network diagnostic ("My TraceRoute").
# JSON output via jansson (new transitive dep — see
# .batteries/reports/mtr.md). Needs root for raw sockets; this disc runs
# as root, so no setuid/setcap wiring is used (USE=-filecaps).
net-analyzer/mtr

# Hardware info
sys-apps/smartmontools
sys-apps/hdparm
sys-apps/dmidecode

# Data tools

# Mouse support
sys-libs/gpm

# Amusements
games-misc/bsd-games
app-misc/figlet
app-misc/cmatrix
app-misc/sl

# rl144 — a deterministic, integer-only roguelike written in Rust, built for the
# 486DX (terminal backend, static musl). Cross-built via the overlay ebuild using
# rustup nightly + -Zbuild-std (see Dockerfile + configs/overlay/games-roguelike/rl144).
games-roguelike/rl144

# nethack — pinned to the last 3.6.x release. 5.0.0 (current ::gentoo head)
# requires USE=lua (REQUIRED_USE on lua_single_target_*) and restructured its
# util/Makefile build-variable names (MYCFLAGS/MYCXXFLAGS vs. this repo's
# CC_FOR_BUILD patch in configs/portage/bashrc, written for the 3.6.x shape).
# Pinning with '=' also stops any future epoch bump from silently floating
# this back up to 5.0.0 the way the unqualified atom did on 2026-08-02.
=games-roguelike/nethack-3.6.7-r1

# Module tools for the loadable-driver regime — modprobe/lsmod/depmod in the
# booted GNU rootfs (busybox's module applets are initramfs-only). Also gives
# the user `modprobe` at the shell: the drivers are on the disc; load what you like.
sys-apps/kmod
