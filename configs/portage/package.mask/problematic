# Mask problematic package versions
#
# Some versions may have issues with cross-compilation,
# static linking, or musl compatibility.
# Add them here to prevent emerge from selecting them.

# Example:
# Block specific broken versions
# =net-misc/curl-8.0.0
# =app-shells/bash-5.2_p15

# Block entire version ranges
# >=dev-lang/lua-5.5

# man-db pulls virtual/tmpfiles → systemd-utils[tmpfiles] which has a hard
# REQUIRED_USE on PYTHON_SINGLE_TARGET. Mask it so virtual/man resolves to
# app-text/mandoc instead.
sys-apps/man-db

# fortune-mod CMake requires a pre-installed native 'strfile' binary in PATH.
# Cross-compiling this is a circular build-tool dependency.
# Re-enable by installing fortune-mod natively in the Dockerfile first.
games-misc/fortune-mod

# mc hard-requires e2fsprogs[tools], but e2fsprogs+tools fails to build statically
# (tools link against libext2fs.so rather than libext2fs.a).
app-misc/mc

# pciutils: cross-linker includes crt1.o (exe startup) when building libpci.so;
# build system incompatibility with the musl cross-compile toolchain.
sys-apps/pciutils


# zstd: meson builds a test/shared artifact that hits the same -static+-shared
# crt1.o error; not needed by anything in world. Re-enable with a meson patch
# like the libxml2 testdso rewrite (configs/portage/bashrc) if a package needs it.
app-arch/zstd

# libcaca: uses C++ exceptions with -fno-exceptions; toilet depends on libcaca.
# Fixing requires per-package fexceptions override AND shared lib cross-compile fix.
media-libs/libcaca
app-misc/toilet

# nethogs requires ncurses[cxx]; building ncurses with cxx breaks the ncurses build
# entirely in the musl cross-compile context, cascading to ~20 dependents.
net-analyzer/nethogs

# usbutils → virtual/libudev → systemd-utils has an unconditional REQUIRED_USE on
# python_single_target. Same root cause as nmap. Re-enable by adding Python to world.
sys-apps/usbutils

# nmap has an unconditional REQUIRED_USE on python_single_target even when all
# Python features (ndiff, zenmap, nse) are disabled — pulls in full Python runtime.
# Re-enable by adding dev-lang/python to world and setting python_single_target_python3_12
# in package.use/nmap.
net-analyzer/nmap

# nethack: 5.0.0 needs USE=lua (REQUIRED_USE on lua_single_target_*, unset
# in this build) and restructured util/Makefile build vars that this repo's
# bashrc CC_FOR_BUILD cross-compile patch was not written for (see
# .batteries/reports/nethack.md). world pins =games-roguelike/nethack-3.6.7-r1;
# this mask is belt-and-suspenders in case that pin is ever loosened.
>=games-roguelike/nethack-5.0.0
