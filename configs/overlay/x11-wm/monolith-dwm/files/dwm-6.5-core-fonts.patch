+/*
+ * A core X11 bitmap font is 16-bit (XChar2b: byte1<<8|byte2), which covers the
+ * BMP and matches an iso10646-1/iso8859-1 font's encoding. Codepoints above
+ * U+FFFF (rare in a status bar) draw as '?' rather than being silently mangled.
+ */
+static void
+codepoint_to_xchar2b(long cp, XChar2b *r)
+{
+	if (cp < 0 || cp > 0xFFFF)
+		cp = '?';
+	r->byte1 = (cp >> 8) & 0xff;
+	r->byte2 = cp & 0xff;
+}
+
+/* Decode up to `max` glyphs of UTF-8 (byte-length `len`) into an XChar2b[].
+ * Returns the glyph count. */
+static int
+utf8_to_xchar2b(const char *text, size_t len, XChar2b *out, int max)
+{
+	size_t i = 0;
+	int n = 0;
+	long cp;
+
+	while (i < len && n < max) {
+		size_t cl = utf8decode(text + i, &cp, len - i);
+		if (!cl)
+			break;
+		codepoint_to_xchar2b(cp, &out[n++]);
+		i += cl;
+	}
+	return n;
+}
