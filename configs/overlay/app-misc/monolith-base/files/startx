#!/bin/sh
# startx — bring up the Monolith GUI on the framebuffer: the TinyX Xfbdev
# server (libXfont built-in fonts, no font files on disc) plus a terminal (st).
# The rock does not draw until asked — nothing runs this at boot. When the
# terminal exits, the server comes down with it.
#
# Requires a GRAPHICAL /dev/fb0 (vesafb): boot a framebuffer label (fb / fb800)
# or append `vga=788` at the boot prompt. A plain text-mode console leaves the
# framebuffer in VGA text mode, which the X server cannot claim ("no screens").
#
# On 8 MB, run with swap-on-persist (see the doc beside this script). Serial
# mice: `inputattach --microsoft /dev/ttyS0 &` before startx (protocol is your
# call — startx does not guess it).

# gpm owns the console mouse; release it so X can take the input devices.
if command -v gpm >/dev/null 2>&1; then
	gpm_pid=$(pidof gpm 2>/dev/null) && [ -n "$gpm_pid" ] && kill "$gpm_pid" 2>/dev/null
fi

if [ ! -e /dev/fb0 ]; then
	echo "startx: no /dev/fb0 — boot a framebuffer mode (e.g. append vga=788)" >&2
	exit 1
fi

mkdir -p /tmp/.X11-unix

# The X server, on the framebuffer, with ONLY the built-in fonts.
Xfbdev :0 -fb /dev/fb0 -fp built-ins >/tmp/Xfbdev.log 2>&1 &
xpid=$!

# Wait (up to ~10s) for the server to accept connections on :0.
i=0
while [ ! -S /tmp/.X11-unix/X0 ]; do
	if ! kill -0 "$xpid" 2>/dev/null; then
		echo "startx: Xfbdev exited early — see /tmp/Xfbdev.log" >&2
		exit 1
	fi
	i=$((i + 1))
	if [ "$i" -ge 20 ]; then
		echo "startx: Xfbdev did not come up — see /tmp/Xfbdev.log" >&2
		kill "$xpid" 2>/dev/null
		exit 1
	fi
	sleep 1
done

# The session: a terminal. (A window manager — dwm — and a launcher land in a
# later milestone; for now the terminal IS the session.) Runs in the
# foreground; when it exits, we tear the server down.
DISPLAY=:0 st
rc=$?

kill "$xpid" 2>/dev/null
wait "$xpid" 2>/dev/null
exit "$rc"
