#!/bin/sh
# startx — bring up the Monolith GUI on the framebuffer: the TinyX Xfbdev
# server (libXfont built-in fonts, no font files on disc), the dwm window
# manager, and one terminal (st) already open. The rock does not draw until
# asked — nothing runs this at boot. dwm is the session; when it exits
# (Mod+Shift+q), the server comes down with it.
#
# Requires a GRAPHICAL /dev/fb0 (vesafb): boot a framebuffer label (fb / fb800)
# or append `vga=788` at the boot prompt. A plain text-mode console leaves the
# framebuffer in VGA text mode, which the X server cannot claim ("no screens").
#
# On 8 MB, run with swap-on-persist (see: monolith help persist — `monolith-persist
# init <dev> --swap N`, then `swapon /overlay/swapfile` after each boot). Serial
# mice: `inputattach --microsoft /dev/ttyS0 &` before startx (protocol is your
# call — startx does not guess it).

# gpm owns the console mouse; release it so X can take the input devices.
if command -v gpm >/dev/null 2>&1; then
	gpm_pid=$(pidof gpm 2>/dev/null) && [ -n "$gpm_pid" ] && kill "$gpm_pid" 2>/dev/null
fi

if [ ! -e /dev/fb0 ]; then
	echo "startx: no /dev/fb0 — boot a framebuffer mode (e.g. append vga=788)" >&2
	exit 1
fi

mkdir -p /tmp/.X11-unix

# The X server, on the framebuffer, with the disc font path: our alias dir
# FIRST (it reclaims `fixed`/`variable` for Terminus — font path order is the
# alias tiebreaker), then the Terminus PCFs, then misc (font-misc-misc's 6x13
# and font-cursor-misc's `cursor`). No `built-ins` fallback ON PURPOSE: the
# server refuses to start unless `fixed` and `cursor` resolve from these dirs,
# so a broken alias/index fails loudly (the gui boot-test is the net) instead of
# silently falling back to the compiled-in 6x13.
Xfbdev :0 -fb /dev/fb0 \
    -fp /usr/share/fonts/monolith,/usr/share/fonts/terminus,/usr/share/fonts/misc \
    >/tmp/Xfbdev.log 2>&1 &
xpid=$!

# Wait (up to ~10s) for the server to accept connections on :0.
i=0
while [ ! -S /tmp/.X11-unix/X0 ]; do
	if ! kill -0 "$xpid" 2>/dev/null; then
		echo "startx: Xfbdev exited early — see /tmp/Xfbdev.log" >&2
		exit 1
	fi
	i=$((i + 1))
	if [ "$i" -ge 20 ]; then
		echo "startx: Xfbdev did not come up — see /tmp/Xfbdev.log" >&2
		kill "$xpid" 2>/dev/null
		exit 1
	fi
	sleep 1
done

# The session: dwm, the window manager, as the foreground session leader. When
# dwm exits (Mod+Shift+q) we tear the server down. dwm won't open a terminal on
# its own, so once it owns the root window we start one st for the user (more
# via dwm's Mod+Shift+Return).
DISPLAY=:0 dwm &
wmpid=$!

# Let dwm take the root window before mapping the first client.
sleep 1
DISPLAY=:0 st &

wait "$wmpid"
rc=$?

kill "$xpid" 2>/dev/null
wait "$xpid" 2>/dev/null
exit "$rc"
